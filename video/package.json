{
  "name": "kura-launch-video",
  "private": true,
  "description": "The Kura UI launch film, built with Remotion from the library's own components and cut to a licensed track.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "music": "node scripts/music.mjs",
    "sfx": "node scripts/sfx.mjs",
    "still": "remotion still src/index.ts",
    "render:proof": "node scripts/music.mjs && node scripts/sfx.mjs && remotion render src/index.ts KuraProof out/proof-v2.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/tailwind-v4": "4.0.543",
    "geist": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.543",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "webpack": "5.105.0"
  }
}
